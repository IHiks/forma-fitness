{
  "name": "forma-fitness",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-build": "expo start --dev-client",
    "prebuild:ios": "expo prebuild --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "export:ios": "expo export --platform ios",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run export:ios",
    "verify:ipa": "node scripts/verify-ipa.mjs build/Forma.ipa",
    "ipa:unsigned": "bash scripts/build-unsigned-ipa.sh"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "@types/sql.js": "1.4.11",
    "eslint": "^9.30.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "sharp": "0.35.5",
    "sql.js": "1.15.1",
    "typescript": "~5.9.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "logic",
        "preset": "jest-expo",
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "testMatch": [
          "<rootDir>/src/**/__tests__/**/*.test.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "__tests__/components"
        ]
      },
      {
        "displayName": "components",
        "preset": "jest-expo",
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
        },
        "testMatch": [
          "<rootDir>/src/**/__tests__/components/**/*.test.tsx"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native))"
        ]
      }
    ]
  }
}
